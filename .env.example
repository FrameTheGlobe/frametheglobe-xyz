# ── Required on Vercel: Railway backend URL ───────────────────────────────────
# The persistent Express backend running on Railway handles all heavy API routes.
# Set both on Vercel. In local dev set to http://localhost:4000.
#
# BACKEND_URL=https://cheerful-strength-production.up.railway.app
# NEXT_PUBLIC_BACKEND_URL=https://cheerful-strength-production.up.railway.app

# ── Required on Railway: Groq AI API key ──────────────────────────────────────
# Powers /api/ai-intel, /api/flash-brief, /api/analyst-briefing,
# /api/article-brief, /api/analyze-ticker. Falls back to algorithmic synthesis.
# Get a free key: https://console.groq.com/
#
# GROQ_API_KEY=your_groq_api_key_here

# ── Railway only: background feed refresh ─────────────────────────────────────
# Set to true on Railway (persistent Node) to enable 8-minute background RSS refresh.
# Leave unset on Vercel — serverless instances each starting their own interval
# duplicates 70+ outbound feed fetches × N instances every 8 minutes.
#
# ENABLE_BACKGROUND_REFRESH=true

# ── Optional: OpenSky Network credentials ─────────────────────────────────────
# Raises ADS-B anonymous rate limit from ~100 to ~4000 req/day.
# Register free: https://opensky-network.org/
#
# OPENSKY_USER=your_username
# OPENSKY_PASS=your_password

# ── Optional ──────────────────────────────────────────────────────────────────
# NODE_ENV=production
